# Postgres connection string. With `docker compose up -d` this matches docker-compose.yml.
DATABASE_URL="postgresql://csk_hub:csk_hub@localhost:5433/csk_hub"

# Database for `bun test`. The suite creates it, migrates it, and truncates every
# table in it between tests, so it must never point at a database you care about.
# Required if DATABASE_URL points at a hosted database rather than local Postgres.
TEST_DATABASE_URL="postgresql://csk_hub:csk_hub@localhost:5433/csk_hub_test"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL="http://localhost:3000"

# The address of the first Admin. `bun run db:seed-admin` creates or promotes it.
ADMIN_EMAIL=
# Email (SMTP). Leave SMTP_USER and SMTP_PASSWORD unset in local development:
# emails are then written to the server log, links and all, instead of sent.
#
# In production these authenticate as the choir's Google Workspace account.
# SMTP_PASSWORD must be a Google app password (16 characters, no spaces), which
# requires 2-Step Verification on that account — not the account password.
SMTP_USER=
SMTP_PASSWORD=

# Optional. Defaults shown; smtp.gmail.com:587 is Google Workspace over STARTTLS.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"

# Optional. The From address, defaulting to SMTP_USER. Gmail rejects a From that
# is neither the authenticated account nor one of its verified aliases.
# EMAIL_FROM="CSK Hub <webmaster@choir.chs.chalmers.se>"
