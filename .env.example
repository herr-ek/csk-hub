# Environment Configuration
ENVIRONMENT=development

# DATABASE
# Required. With `docker compose -f docker-compose.dev.yml up -d` this matches that file.
# The deployed stack sets its own; see stack.env.example and docs/deployment.md.
POSTGRES_URL="postgresql://csk_hub:csk_hub@localhost:5433/csk_hub"

# Optional, and only in a maintainer's own untracked .env — never a deployment setting.
# Read by `bun run ops --prod` and nothing else, e.g. through an SSH tunnel to the stack's db.
POSTGRES_URL_PROD=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Set the explicit application origin in production; localhost is for development.
BETTER_AUTH_URL="http://localhost:3000"

# EMAIL
# With no SMTP credentials, messages are logged so local flows remain usable.
EMAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# VAPID KEYS (generate with: bunx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CONTACT_EMAIL=
