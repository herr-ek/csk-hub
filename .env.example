# Postgres connection string. With `docker compose up -d` this matches docker-compose.yml.
DATABASE_URL="postgresql://csk_hub:csk_hub@localhost:5433/csk_hub"

# Database for `bun test`. The suite creates it, migrates it, and truncates every
# table in it between tests, so it must never point at a database you care about.
# Required if DATABASE_URL points at a hosted database rather than local Postgres.
TEST_DATABASE_URL="postgresql://csk_hub:csk_hub@localhost:5433/csk_hub_test"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL="http://localhost:3000"

# The address of the first Admin. `bun run db:seed-admin` creates or promotes it.
ADMIN_EMAIL=
