# Environment for the deployed stack (docker-compose.yml). In Portainer, load this file under
# the stack's "Environment variables" → "Load variables from .env file", then fill it in.
# Never commit the filled-in copy (stack.env is git-ignored).

# Image tag to pull from GHCR: `latest`, or `sha-<short commit>` to pin a release.
IMAGE_TAG=latest

# Host port the app listens on; point the reverse proxy at it.
APP_PORT=3000

# Generate with: openssl rand -hex 32
# It is placed in a connection URL, so avoid /, @, :, ? and # (hex output never has them).
POSTGRES_PASSWORD=

# The exact public origin, e.g. https://hub.example.org. Email links and passkeys depend on it.
BETTER_AUTH_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# smtp sends real email; log only writes it to the container log.
EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Generate the pair once with: bunx web-push generate-vapid-keys
# Keep it for as long as existing push subscriptions should keep working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CONTACT_EMAIL=webmaster@choir.chs.chalmers.se
