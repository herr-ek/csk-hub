# Environment Configuration
ENVIRONMENT=development

# Postgres connection string. With `docker compose up -d` this matches docker-compose.yml.
POSTGRES_URL="postgresql://csk_hub:csk_hub@localhost:5433/csk_hub"
### To connect to production from local machine:
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL="http://localhost:3000"

# EMAIL
# With no SMTP credentials, messages are logged so local flows remain usable.
EMAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
