# Environment Configuration
ENVIRONMENT=development

# Postgres connection string. With `docker compose up -d` this matches docker-compose.yml.
DATABASE_URL="postgresql://csk_hub:csk_hub@localhost:5433/csk_hub"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL="http://localhost:3000"

# EMAIL
# Local and preview environments must keep this as `log`; SMTP is production-only.
EMAIL_MODE=log
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
