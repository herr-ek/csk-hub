# Environment Configuration
ENVIRONMENT=development

# DATABASE
# Required. With `docker compose up -d` this matches docker-compose.yml. Deployed
# instances use the POSTGRES_URL Vercel injects instead.
POSTGRES_URL="postgresql://csk_hub:csk_hub@localhost:5433/csk_hub"

# Optional, and only in a maintainer's own untracked .env — never a deployment setting.
# Read by `bun run ops --prod` and nothing else. Must be the direct (non-pooling) Supabase
# connection on port 5432, not the transaction pooler on 6543, which cannot run migrations.
POSTGRES_URL_PROD=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL="http://localhost:3000"

# EMAIL
# With no SMTP credentials, messages are logged so local flows remain usable.
EMAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# VAPID KEYS (generated at https://vapidkeys.com)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CONTACT_EMAIL=
