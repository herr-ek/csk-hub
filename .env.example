# Environment Configuration
ENVIRONMENT=development

# DATABASE
# Local is the default. With `docker compose up -d` this matches docker-compose.yml.
POSTGRES_URL_LOCAL="postgresql://csk_hub:csk_hub@localhost:5433/csk_hub"

# The direct (non-pooling) Supabase connection string, port 5432 — NOT the transaction
# pooler on 6543, which cannot run migrations. Optional: leave blank unless you administer
# production. Deployed instances ignore both of these and use what Vercel injects.
POSTGRES_URL_PROD=

# DB_TARGET selects between them and defaults to "local" when unset. Do NOT set it here —
# pass it on the command that needs it, so production is never the ambient default:
#   DB_TARGET=prod bun run db:migrate
#   DB_TARGET=prod bun run ops
#
# Supabase's root CA is committed at src/core/config/prod-ca-2021.crt and used by default,
# so connecting to production needs no certificate setup. DB_SSL_CA overrides it for any
# other managed database. There is deliberately no switch to skip verification.
# DB_SSL_CA=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL="http://localhost:3000"

# EMAIL
# With no SMTP credentials, messages are logged so local flows remain usable.
EMAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# VAPID KEYS (generated at https://vapidkeys.com)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CONTACT_EMAIL=
