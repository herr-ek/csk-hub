# Local-machine Postgres overrides, layered on top of `.env` by the `:local` scripts
# (`bun --env-file=.env --env-file=.env.localdb ...`). Without those flags this file is
# ignored — deliberately NOT named `.env.local`, which Bun and Next.js auto-load and
# which would silently redirect the plain `dev`/`db:migrate` scripts away from Supabase.
#
# Matches docker-compose.yml apart from the port, so `docker compose up -d` (5433) and a
# native Postgres.app install (5432) are interchangeable — adjust the port to suit.
POSTGRES_URL="postgresql://csk_hub:csk_hub@localhost:5433/csk_hub"

ENVIRONMENT=development
EMAIL_MODE=log
